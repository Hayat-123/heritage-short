# ============================================================
# .env.example — Copy to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Cloudflare Workers AI (optional — for FLUX.2 klein keyframes) ---
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Permission needed: "AI — Workers AI Read"
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# --- Gemini API (optional — for Gemini TTS or storyboard assistance) ---
# Get from: https://aistudio.google.com/app/apikey
# Not required; narration WAVs are pre-recorded.
GEMINI_API_KEY=your_gemini_key_here

# ============================================================
# How to load this file before running the pipeline:
#
#   Windows (PowerShell):
#     Get-Content .env | ForEach-Object {
#       if ($_ -match '^([^#=]+)=(.*)$') {
#         [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process')
#       }
#     }
#
#   Linux / macOS:
#     export $(grep -v '^#' .env | xargs)
#
#   Or install python-dotenv (pip install python-dotenv) and add to pipeline:
#     from dotenv import load_dotenv; load_dotenv()
# ============================================================
